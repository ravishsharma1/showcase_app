<% content_for :title, "Marketplace" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Marketplace</h1>
    <p class="mt-1 text-sm text-slate-500">Digital products from our community.</p>
  </div>
</div>

<!-- Category filter + search -->
<div class="mt-6 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <%= search_form_for @q, class: "flex flex-1 gap-3" do |f| %>
      <%= f.search_field :name_or_description_cont, placeholder: "Search products...", class: "flex-1 rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit "Search", class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    <%= link_to "All", products_path, class: "rounded-full px-3 py-1 text-sm font-medium #{params[:category_id].blank? ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}" %>
    <% @categories.each do |category| %>
      <%= link_to category.name, products_path(category_id: category.id), class: "rounded-full px-3 py-1 text-sm font-medium #{params[:category_id].to_i == category.id ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}" %>
    <% end %>
  </div>
</div>

<!-- Products grid -->
<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <% @products.each do |product| %>
    <%= link_to product_path(product), class: "group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 hover:shadow-md transition" do %>
      <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 text-2xl">🛍️</div>
      <div class="mt-4 flex items-center justify-between">
        <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700"><%= product.category.name %></span>
      </div>
      <h2 class="mt-2 font-semibold text-slate-900 group-hover:text-indigo-700"><%= product.name %></h2>
      <p class="mt-1 text-sm text-slate-500 line-clamp-2"><%= product.description %></p>
      <p class="mt-3 text-lg font-bold text-indigo-600"><%= product.formatted_price %></p>
    <% end %>
  <% end %>
</div>
