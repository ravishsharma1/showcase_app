<% content_for :title, @product.name %>

<div class="grid gap-8 lg:grid-cols-2">
  <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <div class="flex h-40 w-40 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-700 text-6xl">🛍️</div>
    <div class="mt-6">
      <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700"><%= @product.category.name %></span>
      <h1 class="mt-2 text-2xl font-bold text-slate-900"><%= @product.name %></h1>
      <p class="mt-2 text-slate-600"><%= @product.description %></p>
      <p class="mt-4 text-3xl font-bold text-indigo-600"><%= @product.formatted_price %></p>
    </div>
  </div>

  <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold text-slate-900">Purchase</h2>
    <% if user_signed_in? %>
      <%= form_with url: orders_path, method: :post, class: "mt-4 space-y-4" do |f| %>
        <%= hidden_field_tag :product_id, @product.id %>
        <div>
          <%= label_tag :quantity, "Quantity", class: "block text-sm font-medium text-slate-700" %>
          <%= number_field_tag :quantity, 1, min: 1, class: "mt-1 w-32 rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
        </div>
        <%= f.submit "Place Order", class: "rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-600">Please <%= link_to "sign in", new_user_session_path, class: "text-indigo-600 font-medium" %> to purchase this product.</p>
    <% end %>
  </div>
</div>
