<% content_for :title, "My Orders" %>

<h1 class="text-2xl font-bold text-slate-900">My Orders</h1>
<p class="mt-1 text-sm text-slate-500">Track your marketplace purchases.</p>

<div class="mt-6 space-y-4">
  <% if @orders.any? %>
    <% @orders.each do |order| %>
      <%= link_to order_path(order), class: "block rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 transition" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="font-semibold text-slate-900">Order #<%= order.id %></p>
            <p class="mt-1 text-sm text-slate-500"><%= order.created_at.strftime("%B %d, %Y") %> · <%= pluralize(order.order_items.sum(&:quantity), "item") %></p>
          </div>
          <div class="text-right">
            <p class="font-bold text-slate-900"><%= order.formatted_total %></p>
            <%= status_badge(order.status) %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="rounded-2xl bg-white p-12 text-center shadow-sm ring-1 ring-slate-200">
      <p class="text-4xl">🛒</p>
      <p class="mt-4 font-semibold text-slate-900">No orders yet</p>
      <p class="mt-1 text-sm text-slate-500"><%= link_to "Browse the marketplace", products_path, class: "text-indigo-600" %> to get started.</p>
    </div>
  <% end %>
</div>
