<% content_for :title, "Manage Categories" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Manage Categories</h1>
    <p class="mt-1 text-sm text-slate-500">Categories are used across the marketplace and blog.</p>
  </div>
  <%= link_to "Back to Admin", admin_dashboard_path, class: "text-sm text-indigo-600 hover:text-indigo-700" %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="font-semibold text-slate-900">Add Category</h2>
    <%= form_with model: [:admin, Category.new], class: "mt-4 flex gap-3" do |f| %>
      <%= f.text_field :name, placeholder: "Category name", class: "flex-1 rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit "Add", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
    <% end %>
  </div>

  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="font-semibold text-slate-900">Existing Categories</h2>
    <div class="mt-4 space-y-3">
      <% @categories.each do |category| %>
        <div class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-3">
          <div>
            <p class="font-medium text-slate-800"><%= category.name %></p>
            <p class="text-xs text-slate-500"><%= pluralize(category.products.count, "product") %> · <%= pluralize(category.posts.count, "post") %></p>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to "Edit", edit_admin_category_path(category), class: "text-sm text-indigo-600 hover:text-indigo-700" %>
            <%= button_to "Delete", admin_category_path(category), method: :delete, data: { turbo_confirm: "Delete this category?" }, class: "text-sm text-rose-600 hover:text-rose-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
