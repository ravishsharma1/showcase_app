<% content_for :title, @project.title %>

<div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= @project.title %></h1>
      <p class="mt-2 text-slate-600"><%= @project.description %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_project_path(@project), class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= button_to "Delete", @project, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "rounded-lg border border-rose-300 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-50" %>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-4">
    <%= status_badge(@project.status) %>
    <div class="flex-1">
      <div class="flex items-center justify-between text-xs text-slate-500">
        <span>Progress</span>
        <span><%= @project.progress_percentage %>%</span>
      </div>
      <div class="mt-1 h-2 w-full rounded-full bg-slate-100">
        <div class="h-2 rounded-full bg-indigo-600" style="width: <%= @project.progress_percentage %>%"></div>
      </div>
    </div>
  </div>
</div>

<!-- Tasks -->
<div class="mt-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <h2 class="text-lg font-semibold text-slate-900">Tasks</h2>

  <%= form_with model: [@project, @task], class: "mt-4 rounded-lg border border-slate-200 p-4" do |f| %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= f.label :title, "Task title", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :title, placeholder: "e.g. Design the landing page", class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :priority, Task.priorities.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :due_date, class: "block text-sm font-medium text-slate-700" %>
        <%= f.date_field :due_date, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :status, Task.statuses.map { |s| [s[0].titleize, s[0]] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
      </div>
    </div>
    <div class="mt-3">
      <%= f.submit "Add Task", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
    </div>
  <% end %>

  <div class="mt-6 space-y-3">
    <% @tasks.each do |task| %>
      <div class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-3">
        <div class="flex items-center gap-3">
          <%= priority_badge(task.priority) %>
          <div>
            <p class="font-medium text-slate-800"><%= task.title %></p>
            <p class="text-xs text-slate-500">
              <%= task.status&.titleize || "Todo" %>
              <% if task.due_date %>
                · Due <%= task.due_date.strftime("%b %d") %>
                <% if task.due_date < Date.today && !task.done? %>
                  <span class="text-rose-600 font-medium">(overdue)</span>
                <% end %>
              <% end %>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_task_path(task), class: "text-sm text-indigo-600 hover:text-indigo-700" %>
          <%= button_to "Delete", task_path(task), method: :delete, data: { turbo_confirm: "Delete this task?" }, class: "text-sm text-rose-600 hover:text-rose-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
