<% content_for :title, "My Projects" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">My Projects</h1>
    <p class="mt-1 text-sm text-slate-500">Plan and track your work.</p>
  </div>
  <%= link_to "New Project", new_project_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @projects.each do |project| %>
    <%= link_to project_path(project), class: "rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 transition" do %>
      <div class="flex items-start justify-between">
        <h2 class="font-semibold text-slate-900"><%= project.title %></h2>
        <%= status_badge(project.status) %>
      </div>
      <p class="mt-2 text-sm text-slate-500 line-clamp-2"><%= project.description %></p>
      <div class="mt-4">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span><%= pluralize(project.tasks.count, "task") %></span>
          <span><%= project.progress_percentage %>% complete</span>
        </div>
        <div class="mt-1 h-1.5 w-full rounded-full bg-slate-100">
          <div class="h-1.5 rounded-full bg-indigo-600" style="width: <%= project.progress_percentage %>%"></div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
