<%= form_with model: project, class: "space-y-6" do |f| %>
  <% if project.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3">
      <h2 class="text-sm font-semibold text-rose-800"><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>
      <ul class="mt-2 list-disc pl-5 text-sm text-rose-700">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :title, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :status, class: "block text-sm font-medium text-slate-700" %>
    <%= f.select :status, Project.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Save Project", class: "rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
    <%= link_to "Cancel", projects_path, class: "rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>
