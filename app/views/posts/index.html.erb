<% content_for :title, "Blog" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Blog</h1>
    <p class="mt-1 text-sm text-slate-500">Insights and stories from the community.</p>
  </div>
</div>

<!-- Category filter + search -->
<div class="mt-6 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <%= search_form_for @q, class: "flex flex-1 gap-3" do |f| %>
      <%= f.search_field :title_or_body_cont, placeholder: "Search posts...", class: "flex-1 rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit "Search", class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    <%= link_to "All", posts_path, class: "rounded-full px-3 py-1 text-sm font-medium #{params[:category_id].blank? ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}" %>
    <% @categories.each do |category| %>
      <%= link_to category.name, posts_path(category_id: category.id), class: "rounded-full px-3 py-1 text-sm font-medium #{params[:category_id].to_i == category.id ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}" %>
    <% end %>
  </div>
</div>

<!-- Posts -->
<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <% @posts.each do |post| %>
    <%= link_to post_path(post), class: "group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 hover:shadow-md transition" do %>
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <span class="rounded-full bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700"><%= post.category.name %></span>
        <span>by <%= post.user.name %></span>
        <span>· <%= time_ago_in_words(post.created_at) %> ago</span>
      </div>
      <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:text-indigo-700"><%= post.title %></h2>
      <p class="mt-2 text-sm text-slate-500 line-clamp-3"><%= strip_tags(post.body) %></p>
      <p class="mt-4 text-sm font-medium text-indigo-600"><%= pluralize(post.comments.count, "comment") %></p>
    <% end %>
  <% end %>
</div>
