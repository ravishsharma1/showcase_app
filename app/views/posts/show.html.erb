<% content_for :title, @post.title %>

<article class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center gap-2 text-sm text-slate-500">
    <span class="rounded-full bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700"><%= @post.category.name %></span>
    <span>by <%= @post.user.name %></span>
    <span>· <%= @post.created_at.strftime("%B %d, %Y") %></span>
  </div>
  <h1 class="mt-4 text-3xl font-bold text-slate-900"><%= @post.title %></h1>
  <div class="prose prose-slate mt-6 max-w-none">
    <p class="whitespace-pre-wrap text-slate-700"><%= @post.body %></p>
  </div>
</article>

<!-- Comments -->
<div class="mt-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <h2 class="text-lg font-semibold text-slate-900">Comments (<%= @comments.count %>)</h2>

  <% if user_signed_in? %>
    <%= form_with model: [@post, @comment], class: "mt-4" do |f| %>
      <div>
        <%= f.label :body, "Add a comment", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_area :body, rows: 3, placeholder: "Share your thoughts...", class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div class="mt-3">
        <%= f.submit "Post Comment", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      </div>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-slate-600">Please <%= link_to "sign in", new_user_session_path, class: "text-indigo-600 font-medium" %> to comment.</p>
  <% end %>

  <div class="mt-6 space-y-4">
    <% @comments.each do |comment| %>
      <div class="rounded-lg border border-slate-200 p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-xs font-semibold"><%= comment.user.name&.first&.upcase %></div>
            <span class="text-sm font-medium text-slate-800"><%= comment.user.name %></span>
            <span class="text-xs text-slate-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <% if comment.user == current_user || current_user&.admin? %>
            <%= button_to "Delete", comment_path(comment), method: :delete, data: { turbo_confirm: "Delete this comment?" }, class: "text-xs text-rose-600 hover:text-rose-700" %>
          <% end %>
        </div>
        <p class="mt-2 text-sm text-slate-700"><%= comment.body %></p>
      </div>
    <% end %>
  </div>
</div>
