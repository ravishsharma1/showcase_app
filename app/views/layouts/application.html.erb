<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WorkHub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WorkHub">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased">
    <%= render "shared/navbar" %>

    <% if notice %>
      <div class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800" data-controller="dismiss">
          <%= notice %>
          <button data-action="dismiss#hide" class="float-right font-bold">&times;</button>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-sm text-rose-800" data-controller="dismiss">
          <%= alert %>
          <button data-action="dismiss#hide" class="float-right font-bold">&times;</button>
        </div>
      </div>
    <% end %>

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
