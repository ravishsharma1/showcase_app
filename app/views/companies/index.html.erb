<% content_for :title, "My Companies" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">My Companies</h1>
    <p class="mt-1 text-sm text-slate-500">Manage the companies you post jobs for.</p>
  </div>
  <%= link_to "New Company", new_company_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @companies.each do |company| %>
    <%= link_to company_path(company), class: "rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 transition" do %>
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 text-xl">🏢</div>
      <h2 class="mt-3 font-semibold text-slate-900"><%= company.name %></h2>
      <p class="mt-1 text-sm text-slate-500 line-clamp-2"><%= company.description %></p>
      <p class="mt-3 text-sm font-medium text-indigo-600"><%= pluralize(company.jobs.count, "job") %></p>
    <% end %>
  <% end %>
</div>
