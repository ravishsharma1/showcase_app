<% content_for :title, "New Job" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold text-slate-900">Post a New Job</h1>
  <p class="mt-1 text-sm text-slate-500">Posting for <%= @company.name %></p>
  <div class="mt-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <%= render "form", job: @job %>
  </div>
</div>
