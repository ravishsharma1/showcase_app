<% content_for :title, @job.title %>

<div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold text-slate-900"><%= @job.title %></h1>
        <%= status_badge(@job.status) %>
      </div>
      <p class="mt-2 text-slate-500"><%= @job.company.name %></p>
    </div>
    <% if @job.company.user == current_user || current_user&.admin? %>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_job_path(@job), class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
        <%= button_to "Delete", @job, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "rounded-lg border border-rose-300 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-50" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 flex flex-wrap gap-4 text-sm">
    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-slate-700">📍 <%= @job.location.presence || "Remote" %></span>
    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-slate-700">💰 <%= @job.salary_range %></span>
    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-slate-700">💼 <%= @job.employment_type&.titleize || "Full Time" %></span>
  </div>

  <div class="prose prose-slate mt-8 max-w-none">
    <h3 class="text-lg font-semibold text-slate-900">Job Description</h3>
    <p class="mt-2 whitespace-pre-wrap text-slate-700"><%= @job.description %></p>
  </div>

  <div class="mt-8 border-t border-slate-200 pt-6">
    <h3 class="text-lg font-semibold text-slate-900">About <%= @job.company.name %></h3>
    <p class="mt-2 text-slate-600"><%= @job.company.description %></p>
    <% if @job.company.website.present? %>
      <p class="mt-2 text-sm"><%= link_to @job.company.website, safe_external_url(@job.company.website), target: "_blank", rel: "noopener noreferrer", class: "text-indigo-600 hover:text-indigo-700" %></p>
    <% end %>
  </div>
</div>

<!-- Apply section -->
<div class="mt-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
  <% if user_signed_in? %>
    <% if @application %>
      <div class="flex items-center justify-between">
        <div>
          <p class="font-semibold text-slate-900">You've applied to this job</p>
          <p class="mt-1 text-sm text-slate-500">Status: <%= status_badge(@application.status) %></p>
        </div>
        <%= button_to "Withdraw application", job_job_application_path(@job, @application), method: :delete, class: "rounded-lg border border-rose-300 px-4 py-2 text-sm font-medium text-rose-700 hover:bg-rose-50" %>
      </div>
    <% elsif @job.published? %>
      <h3 class="text-lg font-semibold text-slate-900">Apply for this job</h3>
      <%= form_with model: [@job, JobApplication.new], class: "mt-4" do |f| %>
        <div>
          <%= f.label :cover_letter, "Cover letter", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_area :cover_letter, rows: 5, placeholder: "Tell us why you're a great fit...", class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>
        <div class="mt-4">
          <%= f.submit "Submit Application", class: "rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500">This job is not currently accepting applications.</p>
    <% end %>
  <% else %>
    <p class="text-sm text-slate-600">Please <%= link_to "sign in", new_user_session_path, class: "text-indigo-600 font-medium" %> to apply for this job.</p>
  <% end %>
</div>
