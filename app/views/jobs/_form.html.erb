<%= form_with model: job, class: "space-y-6" do |f| %>
  <% if job.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3">
      <h2 class="text-sm font-semibold text-rose-800"><%= pluralize(job.errors.count, "error") %> prohibited this job from being saved:</h2>
      <ul class="mt-2 list-disc pl-5 text-sm text-rose-700">
        <% job.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :title, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 6, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= f.label :location, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :location, placeholder: "Remote, New York, London...", class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :employment_type, class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :employment_type, Job.employment_types.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :salary_min, class: "block text-sm font-medium text-slate-700" %>
      <%= f.number_field :salary_min, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :salary_max, class: "block text-sm font-medium text-slate-700" %>
      <%= f.number_field :salary_max, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :status, Job.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 text-sm" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Save Job", class: "rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
    <%= link_to "Cancel", jobs_path, class: "rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>
