<% content_for :title, "WorkHub — Jobs, Marketplace, Blog & Projects" %>

<!-- Hero -->
<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-purple-700 text-white">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="relative px-6 py-16 sm:px-12 sm:py-20">
    <div class="max-w-3xl">
      <p class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-sm font-medium ring-1 ring-white/20">Rails 8 · PostgreSQL · Hotwire · Tailwind</p>
      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">Your all-in-one freelancer platform</h1>
      <p class="mt-4 text-lg text-indigo-100">Find jobs, sell digital products, read the blog, and manage your projects — all in one modern Rails application.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Browse Jobs", jobs_path, class: "rounded-lg bg-white px-5 py-3 text-sm font-semibold text-indigo-700 hover:bg-indigo-50" %>
        <%= link_to "Explore Marketplace", products_path, class: "rounded-lg bg-indigo-500/50 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/30 hover:bg-indigo-500/70" %>
      </div>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <% @stats.each do |label, value| %>
    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
      <p class="text-3xl font-bold text-slate-900"><%= number_with_delimiter(value) %></p>
      <p class="mt-1 text-sm font-medium text-slate-500"><%= label.to_s.titleize %></p>
    </div>
  <% end %>
</section>

<!-- Featured Jobs -->
<section class="mt-12">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold text-slate-900">Featured Jobs</h2>
    <%= link_to "View all jobs →", jobs_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
  </div>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @featured_jobs.each do |job| %>
      <%= link_to job_path(job), class: "group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 hover:shadow-md transition" do %>
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-semibold text-slate-900 group-hover:text-indigo-700"><%= job.title %></h3>
            <p class="mt-1 text-sm text-slate-500"><%= job.company.name %></p>
          </div>
          <%= status_badge(job.status) %>
        </div>
        <div class="mt-4 flex items-center gap-4 text-sm text-slate-500">
          <span>📍 <%= job.location.presence || "Remote" %></span>
          <span>💰 <%= job.salary_range %></span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Marketplace + Blog -->
<section class="mt-12 grid gap-8 lg:grid-cols-2">
  <div>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900">Marketplace</h2>
      <%= link_to "Shop all →", products_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <% @featured_products.each do |product| %>
        <%= link_to product_path(product), class: "rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 transition" do %>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 text-xl">🛍️</div>
          <h3 class="mt-3 font-semibold text-slate-900"><%= product.name %></h3>
          <p class="mt-1 text-sm text-slate-500 line-clamp-2"><%= product.description %></p>
          <p class="mt-3 font-bold text-indigo-600"><%= product.formatted_price %></p>
        <% end %>
      <% end %>
    </div>
  </div>

  <div>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900">Latest from the Blog</h2>
      <%= link_to "All posts →", posts_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
    </div>
    <div class="mt-6 space-y-4">
      <% @recent_posts.each do |post| %>
        <%= link_to post_path(post), class: "block rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-300 transition" do %>
          <div class="flex items-center gap-2 text-xs text-slate-500">
            <span class="rounded-full bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700"><%= post.category.name %></span>
            <span><%= time_ago_in_words(post.created_at) %> ago</span>
          </div>
          <h3 class="mt-2 font-semibold text-slate-900"><%= post.title %></h3>
          <p class="mt-1 text-sm text-slate-500 line-clamp-2"><%= strip_tags(post.body) %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
