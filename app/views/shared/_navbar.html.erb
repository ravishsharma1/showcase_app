<nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-8">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-white font-bold">W</div>
          <span class="text-xl font-bold text-slate-900">WorkHub</span>
        <% end %>

        <div class="hidden md:flex items-center gap-1">
          <%= link_to "Jobs", jobs_path, class: "px-3 py-2 rounded-md text-sm font-medium #{nav_active?(jobs_path)}" %>
          <%= link_to "Marketplace", products_path, class: "px-3 py-2 rounded-md text-sm font-medium #{nav_active?(products_path)}" %>
          <%= link_to "Blog", posts_path, class: "px-3 py-2 rounded-md text-sm font-medium #{nav_active?(posts_path)}" %>
          <% if user_signed_in? %>
            <%= link_to "Projects", projects_path, class: "px-3 py-2 rounded-md text-sm font-medium #{nav_active?(projects_path)}" %>
            <%= link_to "Dashboard", dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{nav_active?(dashboard_path)}" %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%= link_to "Admin", admin_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium text-amber-700 hover:bg-amber-50" %>
          <% end %>
          <div class="hidden sm:flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-sm font-semibold">
              <%= current_user.name&.first&.upcase || "U" %>
            </div>
            <span class="text-sm font-medium text-slate-700"><%= current_user.name %></span>
          </div>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-100" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:bg-slate-100" %>
          <%= link_to "Sign up", new_user_registration_path, class: "px-4 py-2 rounded-md text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
